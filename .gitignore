# demo/ 是公开的实验页，需要入库；不要忽略它

# Dependencies
node_modules/

# Build outputs
dist/
build/
*.min.js
# 后台用到的本地 GSAP 副本必须入库，否则线上四个脚本全部 404
!tools/public/gsap.min.js
!tools/public/ScrollToPlugin.min.js
!tools/public/Flip.min.js
!tools/public/SplitText.min.js

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.upload/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache
.cache/
.parcel-cache/
.eslintcache

# Generated files
*.html.bak
*.css.bak
*.js.bak

# Blog generator (tools/)
tools/.preview/          # 本地预览构建输出（不入库）
tools/.verify-preview/   # verify 脚本的临时比对目录（不入库）
tools/.d*.txt            # 临时差异对比文件
tools/.tmp*              # 临时测试产物
tools/.admin-token       # 后台管理口令（凭证，绝不入库）
tools/tags.json          # 标签池（运行时生成）

# Live2D cache
Live2D/

# Video files
*.mp4
*.mov
*.avi

# Large media
*.zip
*.rar

# Git hooks
.git/hooks/

# Production
CNAME